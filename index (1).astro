---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@type': 'Organization', name: 'Zealous' },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.id}/`}
  type="article"
  extraJsonLd={[articleJsonLd]}
>
  <article class="section post">
    <div class="wrap post-head">
      <p class="eyebrow">The GEO Nerd</p>
      <h1>{post.data.title}</h1>
      <p class="post-meta slate">
        {post.data.author} &middot;{' '}
        {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
      </p>
    </div>
    <div class="wrap post-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post-head { max-width: 46rem; margin-inline: auto; text-align: left; padding-bottom: 2rem; }
  .post-head h1 { margin-block: 0.6rem 0.8rem; }
  .post-body { max-width: 46rem; margin-inline: auto; }
  .post-body :global(p) { margin-bottom: 1.2em; font-size: 1.08rem; }
  .post-body :global(h2) { font-size: 1.6rem; margin-top: 2rem; margin-bottom: 0.6rem; }
  .post-body :global(a) { color: var(--red); }
  .post-body :global(blockquote) {
    border-left: 3px solid var(--red);
    margin: 1.5rem 0;
    padding-left: 1.25rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
  }
</style>
