---
import BaseLayout from '../../layouts/BaseLayout.astro';

const values = [
  { label: 'Transparent', body: 'You always know what we\u2019re doing and why it\u2019s in the plan.' },
  { label: 'Proactive', body: 'We bring ideas before you have to ask for them.' },
  { label: 'Agile', body: 'The media and AI landscape moves fast. So do we.' },
  { label: 'Dedicated', body: 'Quality over quantity, and completely invested in your mission.' },
];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yasmine Triana',
  jobTitle: 'Founder, Zealous',
  email: 'yasmine.triana@zealouspr.com',
  sameAs: ['https://www.linkedin.com/in/yasminetriana'],
  worksFor: { '@type': 'Organization', name: 'Zealous' },
  description:
    'Founder of Zealous, a creative PR, social and GEO specialist agency. Former Director of a PR Week Top 150 agency and UK representative for the PR Global Network (PRGN), with 16+ years\u2019 experience across construction, automotive, property, B2B technology, personal finance and professional services.',
};
---

<BaseLayout
  title="About Zealous & Founder Yasmine Triana"
  description="Meet Yasmine Triana, founder of Zealous — 16+ years in PR, former Director of a PR Week Top 150 agency and UK rep for the PR Global Network."
  path="/about/"
  extraJsonLd={[personJsonLd]}
>
  <section class="section hero-sm">
    <div class="wrap">
      <p class="eyebrow">About</p>
      <h1>PR that's earned its stripes — and its algorithms.</h1>
      <p class="lede">
        Zealous is a creative PR, social media and GEO specialist agency. We believe every piece of earned and owned media — every campaign, post and press release — should work exceedingly hard for your business, anchored by a strategy that complements your actual goals.
      </p>
    </div>
  </section>

  <section class="section section-dim founder">
    <div class="wrap founder-grid">
      <div class="founder-photo" role="img" aria-label="Portrait of Yasmine Triana, founder of Zealous">
        <span>YT</span>
      </div>
      <div>
        <p class="eyebrow">Meet the founder</p>
        <h2>Hi, I'm Yasmine.</h2>
        <p class="lede">
          Former Director of a PR Week Top 150 agency and UK representative for the PR Global Network (PRGN). Over 16 years, my clients have ranged from one-person startups to global enterprises, across construction, automotive, property &amp; placemaking, B2B technology, personal finance and professional services.
        </p>
        <p class="slate">
          I have a particular interest in products, people and services making a genuine positive impact on their industries, communities or the environment. I invest in really understanding a client — their pain points, ambitions and history — before building a tailored PR and social strategy. There's no cookie-cutter approach for any client I work with.
        </p>
        <p class="slate">
          As a parent, my ambition is to work with clients I believe in — the kind of businesses I'd want my own son to grow up seeing do well.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">How we work</p>
      <h2>Quality, over quantity — always.</h2>
      <div class="values">
        {values.map((v) => (
          <div class="value">
            <h3>{v.label}</h3>
            <p class="slate">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark cta-band">
    <div class="wrap cta-band-inner">
      <h2>Let's talk about your business.</h2>
      <p class="lede" style="color:#d9d5c8">No cookie-cutter pitch — just a conversation about where you want to be known, and how to get you there.</p>
      <a class="btn btn-primary btn-on-dark" href="/contact/">Get in touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-sm { padding-block: clamp(2.5rem, 6vw, 4rem) 1rem; }
  .hero-sm h1 { margin-block: 0.6rem 1.2rem; max-width: 20ch; }

  .founder-grid { display: grid; grid-template-columns: 0.55fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .founder-photo {
    aspect-ratio: 4 / 5;
    background: var(--ink);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .founder-photo span {
    font-family: var(--font-display);
    font-size: 4.5rem;
    color: var(--yellow);
  }
  .founder h2 { margin: 0.5rem 0 1.2rem; }
  .founder p + p { margin-top: 1rem; }

  .values { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; margin-top: 2.5rem; }
  .value { border-top: 2px solid var(--red); padding-top: 1rem; }
  .value h3 { margin: 0 0 0.5rem; font-size: 1.1rem; }

  .cta-band-inner { text-align: center; display: grid; gap: 1.5rem; justify-items: center; max-width: 50ch; margin-inline: auto; }

  @media (max-width: 900px) {
    .founder-grid { grid-template-columns: 1fr; }
    .founder-photo { max-width: 260px; }
    .values { grid-template-columns: 1fr 1fr; }
  }
</style>
