---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import OrbitField from '../components/OrbitField.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'home');
const c = page!.data;
const pillarIcons = ['megaphone', 'signal', 'award'] as const;
const methodIcons = ['search', 'bolt', 'trend'] as const;

function parseStat(value: string) {
  const match = value.match(/^([\d.]+)(.*)$/);
  if (!match) return { target: 0, suffix: value, decimals: 0 };
  const [, num, suffix] = match;
  const decimals = num.includes('.') ? num.split('.')[1].length : 0;
  return { target: parseFloat(num), suffix, decimals };
}
---

<BaseLayout
  title={c.seo_title}
  description={c.seo_description}
  path="/"
>
  <section class="hero">
    <OrbitField />
    <div class="wrap hero-grid">
      <div>
        <p class="hero-wordmark">Zealous</p>
        <p class="eyebrow hero-eyebrow">{c.hero_eyebrow}</p>
        <h1>{c.hero_headline} <em>{c.hero_headline_accent}</em></h1>
        <p class="lede">{c.hero_lede}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/contact/">{c.hero_cta_primary}</a>
          <a class="btn btn-ghost" href="/services/">{c.hero_cta_secondary}</a>
        </div>
      </div>
      <div class="stat-panel" aria-label="Why PR strategy now has to include AI visibility">
        {c.stats.map((s: { value: string; label: string }) => {
          const { target, suffix, decimals } = parseStat(s.value);
          return (
            <div class="stat">
              <p class="stat-value" data-count-to={target} data-suffix={suffix} data-decimals={decimals}>{s.value}</p>
              <p class="stat-label slate">{s.label}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section signature">
    <div class="wrap">
      <p class="eyebrow">{c.signature_eyebrow}</p>
      <h2>{c.signature_heading}</h2>
      <p class="lede">{c.signature_lede}</p>

      <div class="split">
        <div class="split-card split-old">
          <p class="split-label slate">{c.signature_old_label}</p>
          <p class="split-title">{c.signature_old_title}</p>
          <p class="slate">{c.signature_old_body}</p>
        </div>
        <div class="split-card split-new">
          <p class="split-label" style="color:var(--yellow)">{c.signature_new_label}</p>
          <p class="split-title">{c.signature_new_title}</p>
          <p style="color:#fff0e6">{c.signature_new_body}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{c.pillars_eyebrow}</p>
      <h2>{c.pillars_heading}</h2>
      <div class="pillars">
        {c.pillars.map((p: { label: string; body: string }, i: number) => (
          <article class="pillar lift reveal" data-delay={i * 0.1}>
            <div class="pillar-icon" style={`color:${['var(--coral)', 'var(--blue)', 'var(--mint-deep)'][i % 3]}`}>
              <Icon name={pillarIcons[i % 3]} />
            </div>
            <p class="folio" style={`color:${['var(--coral)', 'var(--blue)', 'var(--mint-deep)'][i % 3]}`}>0{i + 1}</p>
            <h3>{p.label}</h3>
            <p class="slate">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dim">
    <div class="wrap">
      <p class="eyebrow">{c.method_eyebrow}</p>
      <h2>{c.method_heading}</h2>
      <p class="lede">{c.method_lede}</p>
      <ol class="method">
        {c.method.map((m: { step: string; body: string }, i: number) => (
          <li class="reveal" data-delay={i * 0.1}>
            <div class="method-icon"><Icon name={methodIcons[i % 3]} size={32} /></div>
            <div>
              <h3>{m.step}</h3>
              <p class="slate">{m.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-dark cta-band">
    <div class="wrap cta-band-inner">
      <h2>{c.cta_heading}</h2>
      <p class="lede" style="color:#d9d5c8">{c.cta_lede}</p>
      <a class="btn btn-primary btn-on-dark" href="/contact/">{c.cta_button}</a>
    </div>
  </section>
</BaseLayout>

<script>
  function animateCount(el: HTMLElement) {
    const target = parseFloat(el.dataset.countTo || '0');
    const suffix = el.dataset.suffix || '';
    const decimals = parseInt(el.dataset.decimals || '0', 10);
    const duration = 1300;
    const start = performance.now();

    function frame(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const value = target * eased;
      el.textContent = value.toFixed(decimals) + suffix;
      if (progress < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>('[data-count-to]').forEach((el) => {
      el.textContent = '0' + (el.dataset.suffix || '');
      animateCount(el);
    });
  }
</script>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 6vw, 5rem); position: relative; overflow: hidden; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    position: relative;
    z-index: 1;
  }
  .hero-wordmark {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2rem + 3vw, 4.5rem);
    line-height: 0.95;
    color: var(--ink);
    margin: 0 0 0.5rem;
  }
  .hero-eyebrow {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }
  .hero h1 { margin-block: 0.5rem 1.2rem; }
  .hero h1 em { font-style: normal; color: var(--coral); }
  .hero-cta { display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap; }

  .stat-panel {
    background: var(--blue);
    color: #fff;
    border-radius: 4px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    gap: 1.4rem;
  }
  .stat-value {
    font-family: var(--font-mono);
    font-size: clamp(1.8rem, 2vw + 1rem, 2.6rem);
    color: var(--yellow);
    line-height: 1;
    margin: 0 0 0.35rem;
  }
  .stat-label { font-size: 0.85rem; margin: 0; color: #e2e4f7; }
  .stat + .stat { border-top: 1px solid rgba(255,255,255,0.25); padding-top: 1.4rem; }

  .signature { background: var(--paper-dim); color: var(--ink); }
  .signature .slate { color: var(--slate); }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2.5rem; }
  .split-card { border-radius: 4px; padding: 1.75rem; }
  .split-old { background: #fff; border: 1px solid var(--line); }
  .split-new { background: var(--coral); }
  .split-label { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 0.6rem; }
  .split-title { font-family: var(--font-display); text-transform: uppercase; font-size: 1.7rem; font-weight: 400; margin: 0 0 0.6rem; }
  .split-new .split-title { color: #fff; }
  .split-old .split-title { color: var(--ink); }

  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; margin-top: 2.5rem; }
  .pillar {
    background: var(--paper-alt);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 1.75rem;
  }
  .pillar-icon { margin-bottom: 1rem; }
  .pillar .folio { margin-top: 0; }
  .pillar h3 { margin: 0.6rem 0 0.6rem; }

  .method { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: 1.75rem; max-width: 62ch; }
  .method li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; align-items: start; }
  .method-icon { color: var(--coral); padding-top: 0.15rem; }
  .method h3 { margin: 0 0 0.4rem; font-size: 1.2rem; }

  .cta-band-inner { text-align: center; display: grid; gap: 1.5rem; justify-items: center; max-width: 50ch; margin-inline: auto; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .split { grid-template-columns: 1fr; }
    .pillars { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
