---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const sectors = await getCollection('specialisms', ({ data }) => !data.draft);
  return sectors.map((s) => ({
    params: { id: s.id },
    props: { sector: s },
  }));
}

const { sector } = Astro.props;
const { Content } = await render(sector);
---

<BaseLayout
  title={sector.data.title}
  description={sector.data.seo_description}
  path={`/specialisms/${sector.id}/`}
>
  <section class="section hero-sm">
    <div class="wrap">
      <p class="eyebrow"><a href="/specialisms/">Specialisms</a></p>
      <h1>{sector.data.title}</h1>
      <p class="lede">{sector.data.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap post-body">
      <Content />
    </div>
  </section>

  <section class="section section-dark cta-band">
    <div class="wrap cta-band-inner">
      <h2>Let's talk about {sector.data.title.toLowerCase()}.</h2>
      <p class="lede" style="color:#d9d5c8">Tell us about your business and we'll tell you honestly whether — and how — we can help.</p>
      <a class="btn btn-primary btn-on-dark" href="/contact/">Book a strategy call</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-sm { padding-block: clamp(2.5rem, 6vw, 4rem) 1rem; }
  .hero-sm .eyebrow a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
  .hero-sm h1 { margin-block: 0.6rem 1.2rem; max-width: 20ch; }

  .post-body { max-width: 46rem; }
  .post-body :global(p) { margin-bottom: 1.2em; font-size: 1.08rem; }
  .post-body :global(h2) { font-size: 1.6rem; margin-top: 2rem; margin-bottom: 0.6rem; }
  .post-body :global(ul) { margin: 0 0 1.2em; padding-left: 1.2rem; display: grid; gap: 0.5rem; }
  .post-body :global(a) { color: var(--red); }

  .cta-band-inner { text-align: center; display: grid; gap: 1.5rem; justify-items: center; max-width: 50ch; margin-inline: auto; }
</style>
