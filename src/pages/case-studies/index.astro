---
import BaseLayout from '../../layouts/BaseLayout.astro';

const metrics = [
  'Volume & quality of press coverage, mainstream and trade',
  'Share of voice against named competitors',
  'How often — and how accurately — AI engines cite you',
  'Social reach, engagement and follower growth',
  'Referral traffic and enquiry volume from earned & owned media',
  'Sentiment: what people (and AI) actually say about you',
];
---

<BaseLayout
  title="Results — Case Studies"
  description="Zealous is a newly launched agency. Here's exactly how we measure results for clients — and how our own case studies will build from here."
  path="/case-studies/"
>
  <section class="section hero-sm">
    <div class="wrap">
      <p class="eyebrow">Results</p>
      <h1>The results page, being written in real time.</h1>
      <p class="lede">
        Zealous is newly launched — so this page is honest about where we are: no borrowed numbers, no recycled logos. What you'll find below is exactly how we measure success for every client, and the first slots waiting to be filled with real results.
      </p>
    </div>
  </section>

  <section class="section section-dim">
    <div class="wrap">
      <p class="eyebrow">What we measure</p>
      <h2>Accountability, from day one.</h2>
      <p class="lede">Every engagement is benchmarked and tracked against the same core signals:</p>
      <ul class="metrics">
        {metrics.map((m) => <li>{m}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Case studies</p>
      <h2>Reserved for clients like you.</h2>
      <div class="placeholder-grid">
        {[1, 2, 3].map((n) => (
          <div class="placeholder-card">
            <p class="folio">Slot 0{n}</p>
            <p class="placeholder-title">Coming soon</p>
            <p class="slate">This space is reserved for a real client, with real numbers. Could it be yours?</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark cta-band">
    <div class="wrap cta-band-inner">
      <h2>Be our next case study.</h2>
      <p class="lede" style="color:#d9d5c8">Early clients get founder-level attention and a strategy built without a template. Let's start yours.</p>
      <a class="btn btn-primary btn-on-dark" href="/contact/">Book a strategy call</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-sm { padding-block: clamp(2.5rem, 6vw, 4rem) 1rem; }
  .hero-sm h1 { margin-block: 0.6rem 1.2rem; max-width: 20ch; }

  .metrics {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 2.5rem;
    max-width: 70ch;
  }
  .metrics li {
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .placeholder-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 2.5rem; }
  .placeholder-card {
    border: 1px dashed var(--line);
    border-radius: 4px;
    padding: 2rem 1.5rem;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.4rem;
  }
  .placeholder-title { font-family: var(--font-display); font-size: 1.4rem; color: var(--slate); margin: 0; }

  .cta-band-inner { text-align: center; display: grid; gap: 1.5rem; justify-items: center; max-width: 50ch; margin-inline: auto; }

  @media (max-width: 780px) {
    .metrics { grid-template-columns: 1fr; }
    .placeholder-grid { grid-template-columns: 1fr; }
  }
</style>
