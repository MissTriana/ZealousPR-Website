---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'case-studies');
const c = page!.data;
---

<BaseLayout
  title={c.seo_title}
  description={c.seo_description}
  path="/case-studies/"
>
  <section class="section hero-sm">
    <div class="wrap">
      <p class="eyebrow">{c.hero_eyebrow}</p>
      <h1>{c.hero_heading}</h1>
      <p class="lede">{c.hero_lede}</p>
    </div>
  </section>

  <section class="section section-dim">
    <div class="wrap">
      <p class="eyebrow">{c.metrics_eyebrow}</p>
      <h2>{c.metrics_heading}</h2>
      <p class="lede">{c.metrics_lede}</p>
      <ul class="metrics">
        {c.metrics.map((m: string, i: number) => <li class="reveal" data-delay={i * 0.05}>{m}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{c.cases_eyebrow}</p>
      <h2>{c.cases_heading}</h2>
      <div class="placeholder-grid">
        {[1, 2, 3].map((n, i) => (
          <div class="placeholder-card lift reveal" data-delay={i * 0.08}>
            <div class="placeholder-icon"><Icon name="slot" size={32} /></div>
            <p class="folio">Slot 0{n}</p>
            <p class="placeholder-title">{c.placeholder_title}</p>
            <p class="slate">{c.placeholder_body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark cta-band">
    <div class="wrap cta-band-inner">
      <h2>{c.cta_heading}</h2>
      <p class="lede" style="color:#d9d5c8">{c.cta_lede}</p>
      <a class="btn btn-primary btn-on-dark" href="/contact/">{c.cta_button}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-sm { padding-block: clamp(2.5rem, 6vw, 4rem) 1rem; }
  .hero-sm h1 { margin-block: 0.6rem 1.2rem; max-width: 20ch; }

  .metrics {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 2.5rem;
    max-width: 70ch;
  }
  .metrics li {
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .placeholder-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 2.5rem; }
  .placeholder-card {
    border: 1px dashed var(--line);
    border-radius: 4px;
    padding: 2rem 1.5rem;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.4rem;
  }
  .placeholder-title { font-family: var(--font-display); font-size: 1.4rem; color: var(--slate); margin: 0; }
  .placeholder-icon { color: var(--line); margin-bottom: 0.5rem; }

  .cta-band-inner { text-align: center; display: grid; gap: 1.5rem; justify-items: center; max-width: 50ch; margin-inline: auto; }

  @media (max-width: 780px) {
    .metrics { grid-template-columns: 1fr; }
    .placeholder-grid { grid-template-columns: 1fr; }
  }
</style>
