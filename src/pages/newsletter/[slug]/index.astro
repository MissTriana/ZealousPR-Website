---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getSubstackPosts } from '../../../lib/substack';

export async function getStaticPaths() {
  const posts = await getSubstackPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.pubDate.toISOString(),
  author: { '@type': 'Person', name: post.author },
  publisher: { '@type': 'Organization', name: 'Zealous' },
  // Points back to the original Substack post: standard practice for
  // syndicated content, so search engines treat Substack as the source
  // of record rather than penalising this as duplicate content.
  mainEntityOfPage: post.substackUrl,
};
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  path={`/newsletter/${post.slug}/`}
  type="article"
  extraJsonLd={[articleJsonLd]}
  canonicalOverride={post.substackUrl}
>
  <article class="section post">
    <div class="wrap post-head">
      <p class="eyebrow">The GEO Nerd</p>
      <h1>{post.title}</h1>
      <p class="post-meta slate">
        {post.author} &middot;{' '}
        {post.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
        &middot; <a href={post.substackUrl} target="_blank" rel="noopener">Read on Substack</a>
      </p>
    </div>
    <div class="wrap post-body" set:html={post.contentHtml} />
  </article>
</BaseLayout>

<style>
  .post-head { max-width: 46rem; margin-inline: auto; text-align: left; padding-bottom: 2rem; }
  .post-head h1 { margin-block: 0.6rem 0.8rem; }
  .post-body { max-width: 46rem; margin-inline: auto; }
  .post-body :global(p) { margin-bottom: 1.2em; font-size: 1.08rem; }
  .post-body :global(h2) { font-size: 1.6rem; margin-top: 2rem; margin-bottom: 0.6rem; }
  .post-body :global(img) { border-radius: 4px; margin-block: 1.5rem; }
  .post-body :global(a) { color: var(--red); }
  .post-body :global(blockquote) {
    border-left: 3px solid var(--red);
    margin: 1.5rem 0;
    padding-left: 1.25rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
  }
</style>
