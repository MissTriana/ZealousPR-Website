---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSubstackPosts } from '../../lib/substack';

const posts = await getSubstackPosts();
---

<BaseLayout
  title="The GEO Nerd — Newsletter"
  description="PR and GEO thinking from Zealous: how brands earn visibility with journalists, audiences, and AI search engines."
  path="/newsletter/"
>
  <section class="section hero-sm">
    <div class="wrap">
      <p class="eyebrow">The GEO Nerd — Newsletter</p>
      <h1>Notes on PR &amp; the age of AI search.</h1>
      <p class="lede">Field notes, frameworks and the occasional rant, from the desk of Zealous — written on Substack, mirrored here.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {posts.length === 0 ? (
        <p class="slate">First issue is on its way — check back soon, or read along on <a href="https://thegeonerd.substack.com/" target="_blank" rel="noopener">Substack</a> directly.</p>
      ) : (
        <div class="post-list">
          {posts.map((post) => (
            <a class="post-row" href={`/newsletter/${post.slug}/`}>
              <p class="post-date folio">
                {post.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
              </p>
              <div>
                <h2>{post.title}</h2>
                <p class="slate">{post.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-sm { padding-block: clamp(2.5rem, 6vw, 4rem) 1rem; }
  .hero-sm h1 { margin-block: 0.6rem 1.2rem; max-width: 18ch; }

  .post-list { display: grid; gap: 0; }
  .post-row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.5rem;
    text-decoration: none;
    color: var(--ink);
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .post-row:last-child { border-bottom: 1px solid var(--line); }
  .post-row h2 { font-size: 1.4rem; margin-bottom: 0.4rem; transition: color 0.15s ease; }
  .post-row:hover h2 { color: var(--red); }

  @media (max-width: 640px) {
    .post-row { grid-template-columns: 1fr; gap: 0.4rem; }
  }
</style>
