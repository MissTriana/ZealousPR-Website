---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ServiceHubDiagram from '../../components/ServiceHubDiagram.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'services');
const c = page!.data;
const streamIcons = ['megaphone', 'signal', 'people'] as const;
const methodIcons = ['search', 'bolt', 'trend'] as const;
---

<BaseLayout
  title={c.seo_title}
  description={c.seo_description}
  path="/services/"
>
  <section class="section hero-sm">
    <div class="wrap">
      <p class="eyebrow">{c.hero_eyebrow}</p>
      <h1>{c.hero_heading}</h1>
      <p class="lede">{c.hero_lede}</p>
    </div>
  </section>

  <section class="section section-dim">
    <div class="wrap">
      <p class="eyebrow">{c.hub_eyebrow}</p>
      <h2>{c.hub_heading}</h2>
      <p class="lede">{c.hub_lede}</p>
      <div class="hub-wrap reveal" data-delay="0.15">
        <ServiceHubDiagram />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap streams">
      {c.streams.map((s: { n: string; title: string; body: string; items: string[] }, i: number) => (
        <article class="stream lift reveal" data-delay={i * 0.08}>
          <div class="stream-icon" style={`color:${['var(--coral)', 'var(--blue)', 'var(--mint-deep)'][i % 3]}`}>
            <Icon name={streamIcons[i % 3]} />
          </div>
          <div>
            <p class="folio">{s.n}</p>
            <h2>{s.title}</h2>
            <p class="slate stream-body">{s.body}</p>
            {s.items.length > 0 && (
              <ul class="stream-list">
                {s.items.map((it: string) => <li>{it}</li>)}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-dim">
    <div class="wrap">
      <p class="eyebrow">{c.method_eyebrow}</p>
      <h2>{c.method_heading}</h2>
      <p class="lede">{c.method_lede}</p>

      <div class="method-grid">
        {c.method.map((m: { step: string; body: string; items: string[] }, i: number) => (
          <div class="method-card lift reveal" data-delay={i * 0.08}>
            <div class="method-card-icon" style={`color:${['var(--coral)', 'var(--blue)', 'var(--mint-deep)'][i % 3]}`}>
              <Icon name={methodIcons[i % 3]} size={32} />
            </div>
            <p class="folio">Step {i + 1}</p>
            <h3>{m.step}</h3>
            <p class="slate">{m.body}</p>
            {m.items.length > 0 && (
              <ul class="method-list slate">
                {m.items.map((it: string) => <li>{it}</li>)}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark cta-band">
    <div class="wrap cta-band-inner">
      <h2>{c.cta_heading}</h2>
      <p class="lede" style="color:#d9d5c8">{c.cta_lede}</p>
      <a class="btn btn-primary btn-on-dark" href="/contact/">{c.cta_button}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-sm { padding-block: clamp(1.5rem, 3vw, 2.5rem) 1rem; }
  .hero-sm h1 { margin-block: 0.6rem 1.2rem; max-width: 18ch; }
  .hub-wrap { margin-top: 2.5rem; }

  @media (max-width: 640px) {
    .hub-wrap {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 0.5rem;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
    }
    .hub-wrap :global(.hub-diagram) {
      width: 780px;
      max-width: none;
      flex: none;
    }
  }

  .streams { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .stream { display: grid; grid-template-columns: 3rem 1fr; gap: 1.5rem; border-top: 1px solid var(--line); padding-top: 2rem; }
  .stream:first-child { border-top: none; padding-top: 0; }
  .stream-icon { padding-top: 0.2rem; }
  .stream .folio { margin: 0 0 0.5rem; }
  .stream h2 { margin-bottom: 0.75rem; }
  .stream-body { max-width: 56ch; }
  .stream-list { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; gap: 0.5rem; font-family: var(--font-mono); font-weight: 500; font-size: 0.85rem; color: var(--ink-soft); }
  .stream-list li::before { content: '— '; color: var(--red); }

  .method-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 2.5rem; }
  .method-card { background: var(--paper); border-radius: 4px; padding: 1.75rem; }
  .method-card-icon { margin-bottom: 1rem; }
  .method-card h3 { margin: 0.4rem 0 0.75rem; }
  .method-list { margin: 1rem 0 0; padding-left: 1.1rem; display: grid; gap: 0.4rem; font-size: 0.92rem; }

  .cta-band-inner { text-align: center; display: grid; gap: 1.5rem; justify-items: center; max-width: 50ch; margin-inline: auto; }

  @media (max-width: 900px) {
    .stream { grid-template-columns: 1fr; }
    .method-grid { grid-template-columns: 1fr; }
  }
</style>
