---
import { getEntry } from 'astro:content';

const year = new Date().getFullYear();
const socialEntry = await getEntry('pages', 'social');
const social = socialEntry!.data;

const platforms = [
  { url: social.linkedin_url, label: 'LinkedIn', icon: 'linkedin' },
  { url: social.instagram_url, label: 'Instagram', icon: 'instagram' },
  { url: social.youtube_url, label: 'YouTube', icon: 'youtube' },
].filter((p) => p.url);
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <div class="brand-lockup">
        <img src="/logo-mark-light.svg" alt="Zealous" width="48" height="48" class="brand-icon" />
      </div>
      <p class="slate">Creative PR &amp; GEO specialists.<br />Winning hearts, minds, and algorithms.</p>

      {platforms.length > 0 && (
        <div class="social-row">
          {platforms.map((p) => (
            <a href={p.url} target="_blank" rel="noopener" aria-label={p.label} class="social-icon">
              {p.icon === 'linkedin' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="4" />
                  <circle cx="8" cy="8.3" r="0.9" fill="currentColor" stroke="none" />
                  <path d="M8 11v6" />
                  <path d="M12 17v-3.5c0-1.4 1-2.5 2.3-2.5s2.2 1 2.2 2.5V17" />
                </svg>
              )}
              {p.icon === 'instagram' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4.2" />
                  <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
                </svg>
              )}
              {p.icon === 'youtube' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
                  <path d="M10.3 9.2v5.6l5-2.8Z" fill="currentColor" stroke="currentColor" stroke-linejoin="round" />
                </svg>
              )}
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="footer-col">
      <p class="eyebrow">Say hello</p>
      <p><a href="mailto:yasmine.triana@zealouspr.com">yasmine.triana@zealouspr.com</a></p>
      <p><a href="tel:+447496928736">07496 928736</a></p>
    </div>

    <div class="footer-col">
      <p class="eyebrow">Elsewhere</p>
      <p><a href="/newsletter/">The GEO Nerd — our newsletter</a></p>
      <p><a href="/news/">Company news &amp; insights</a></p>
    </div>

    <div class="footer-col">
      <p class="eyebrow">Site</p>
      <p><a href="/services/">Services</a></p>
      <p><a href="/specialisms/">Specialisms</a></p>
      <p><a href="/team/">Team</a></p>
      <p><a href="/about/">About</a></p>
      <p><a href="/contact/">Contact</a></p>
      <p><a href="/faq/">FAQs</a></p>
    </div>
  </div>
  <div class="wrap footer-legal">
    <hr class="rule" />
    <p class="slate">© {year} Zealous PR. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }
  .footer-brand .brand-lockup {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }
  .footer-brand .brand-icon {
    display: block;
    flex: none;
  }
  .footer-brand .wordmark {
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 400;
    line-height: 1;
    margin: 0;
    color: var(--paper);
  }
  .social-row {
    display: flex;
    gap: 0.9rem;
    margin-top: 1.25rem;
  }
  .social-icon {
    color: var(--paper);
    opacity: 0.85;
    display: inline-flex;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .social-icon:hover {
    color: var(--coral);
    opacity: 1;
  }
  .footer-col p { margin: 0 0 0.5rem; }
  .footer-col a { text-decoration: none; }
  .footer-col a:hover { color: var(--red); }
  .site-footer .slate { color: #a8a496; }
  .footer-legal { margin-top: 2.5rem; }
  .footer-legal .rule { border-top-color: #3a372e; margin-bottom: 1rem; }
  .footer-legal p { font-size: 0.85rem; }

  @media (max-width: 780px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .footer-inner { grid-template-columns: 1fr; }
  }
</style>
