---
// Ambient decorative network — echoes the hub-and-spoke diagram on the
// Services page and the "network of citations" idea central to GEO.
// Pure CSS animation (slow rotation + drifting nodes), no JS, and fully
// stops under prefers-reduced-motion.
const dots = [
  { x: 60, y: 40, r: 5, color: 'var(--coral)' },
  { x: 220, y: 90, r: 7, color: 'var(--blue)' },
  { x: 140, y: 180, r: 4, color: 'var(--mint-deep)' },
  { x: 300, y: 200, r: 6, color: 'var(--yellow)' },
  { x: 40, y: 260, r: 5, color: 'var(--violet)' },
  { x: 250, y: 300, r: 4, color: 'var(--coral)' },
  { x: 350, y: 60, r: 4, color: 'var(--mint-deep)' },
  { x: 170, y: 40, r: 3, color: 'var(--violet)' },
];

const links = [
  [0, 1], [1, 2], [2, 0], [1, 3], [3, 5], [2, 4], [4, 5], [1, 6], [0, 7],
];
---

<div class="orbit-field" aria-hidden="true">
  <svg viewBox="0 0 380 340" class="orbit-svg">
    <g class="orbit-spin">
      {links.map(([a, b]) => (
        <line
          x1={dots[a].x} y1={dots[a].y}
          x2={dots[b].x} y2={dots[b].y}
          class="orbit-link"
        />
      ))}
      {dots.map((d, i) => (
        <circle cx={d.x} cy={d.y} r={d.r} fill={d.color} class={`orbit-dot orbit-dot-${i % 4}`} />
      ))}
    </g>
  </svg>
</div>

<style>
  .orbit-field {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }
  .orbit-svg {
    position: absolute;
    top: 50%;
    right: -6%;
    width: 420px;
    max-width: 46vw;
    height: auto;
    transform: translateY(-50%);
    opacity: 0.55;
  }
  .orbit-link {
    stroke: var(--line);
    stroke-width: 1;
  }
  .orbit-spin {
    transform-origin: 190px 170px;
    animation: orbit-rotate 90s linear infinite;
  }
  .orbit-dot {
    animation: orbit-bob 6s ease-in-out infinite;
  }
  .orbit-dot-0 { animation-delay: 0s; }
  .orbit-dot-1 { animation-delay: 1.4s; }
  .orbit-dot-2 { animation-delay: 2.8s; }
  .orbit-dot-3 { animation-delay: 4.2s; }

  @keyframes orbit-rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes orbit-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-spin, .orbit-dot {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .orbit-svg { display: none; }
  }
</style>
