---
import BaseLayout from '../layouts/BaseLayout.astro';

const stats = [
  { value: '94%', label: 'of B2B buyers now use AI somewhere in their buying process' },
  { value: '50%', label: 'of consumers use AI to discover and compare brands' },
  { value: '69.5%', label: 'of Google searches now end without a single click' },
  { value: '4.4x', label: 'higher conversion rate from AI-driven traffic vs. traditional organic' },
];

const pillars = [
  {
    label: 'Earned Media',
    body: 'News, thought leadership and case studies, mapped deliberately against your key messages — so every piece of coverage does a job, not just fills a clippings file.',
  },
  {
    label: 'Owned Media',
    body: 'Your website and social channels, built and written to work exceedingly hard: optimised for AI visibility and genuine human engagement, at the same time.',
  },
  {
    label: 'Accolades',
    body: 'Awards and accreditation selected with intent, chosen to reinforce the exact credibility signals your audiences — and the algorithms — are looking for.',
  },
];

const method = [
  {
    step: 'Audit & assess',
    body: "We benchmark your current footprint for visibility, sentiment, narrative and call-to-action — across search, social, and the AI engines now doing the recommending.",
  },
  {
    step: 'Activate',
    body: 'A bespoke PR & GEO strategy, delivered by specialists in media relations, SEO, award submissions, social and community engagement.',
  },
  {
    step: 'Track & adapt',
    body: "We measure against the original benchmark and short, medium and long-term goals — staying as agile as the media and AI landscape we're operating in.",
  },
];
---

<BaseLayout
  title="Zealous — Creative PR & GEO Specialists"
  description="Zealous is a creative PR, social and GEO specialist agency, helping ambitious businesses win the hearts and minds of journalists, audiences, and AI search engines alike."
  path="/"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Creative PR &amp; GEO Specialists</p>
        <h1>Winning hearts, minds — <em>and algorithms.</em></h1>
        <p class="lede">
          The goal of PR has changed. Today you're building trust with the journalists and audiences who've always mattered — and with the AI engines now doing a growing share of the recommending. Zealous builds one strategy for both.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/contact/">Book a strategy call</a>
          <a class="btn btn-ghost" href="/services/">How it works</a>
        </div>
      </div>
      <div class="stat-panel" aria-label="Why PR strategy now has to include AI visibility">
        {stats.map((s) => (
          <div class="stat">
            <p class="stat-value">{s.value}</p>
            <p class="stat-label slate">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section signature">
    <div class="wrap">
      <p class="eyebrow">Why GEO, why now</p>
      <h2>Your next customer might never see a search result again.</h2>
      <p class="lede">
        Ask an AI engine about your industry today and it gives one answer, built from sources it trusts. Being findable isn't enough anymore — you have to be the source that gets cited. Here's the shift in practice:
      </p>

      <div class="split">
        <div class="split-card split-old">
          <p class="split-label slate">The old way</p>
          <p class="split-title">Ten blue links</p>
          <p class="slate">A searcher scans a results page, weighs a handful of options, and picks one to click — with your brand as one voice among many.</p>
        </div>
        <div class="split-card split-new">
          <p class="split-label" style="color:var(--yellow)">The new way</p>
          <p class="split-title">One synthesised answer</p>
          <p style="color:#d9d5c8">An AI engine reads the web on the searcher's behalf and hands back a single recommendation. If your business isn't part of what it read and trusted, you were never in the running.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What we do</p>
      <h2>Three pillars, one strategy.</h2>
      <div class="pillars">
        {pillars.map((p, i) => (
          <article class="pillar">
            <p class="folio">0{i + 1}</p>
            <h3>{p.label}</h3>
            <p class="slate">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dim">
    <div class="wrap">
      <p class="eyebrow">Our approach</p>
      <h2>Audit. Activate. Track and adapt.</h2>
      <p class="lede">We start with a full-immersion session to get under the skin of your business, then run a repeatable rhythm:</p>
      <ol class="method">
        {method.map((m, i) => (
          <li>
            <span class="folio">0{i + 1}</span>
            <div>
              <h3>{m.step}</h3>
              <p class="slate">{m.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-dark cta-band">
    <div class="wrap cta-band-inner">
      <h2>Ready to be the answer, not just a result?</h2>
      <p class="lede" style="color:#d9d5c8">Tell us about your business and where you want to be known. We'll come back with a strategy, not a sales pitch.</p>
      <a class="btn btn-primary btn-on-dark" href="/contact/">Start the conversation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 6vw, 5rem); }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .hero h1 { margin-block: 0.5rem 1.2rem; }
  .hero h1 em { font-style: italic; color: var(--red); }
  .hero-cta { display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap; }

  .stat-panel {
    background: var(--ink);
    color: var(--paper);
    border-radius: 4px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    gap: 1.4rem;
  }
  .stat-value {
    font-family: var(--font-mono);
    font-size: clamp(1.8rem, 2vw + 1rem, 2.6rem);
    color: var(--yellow);
    line-height: 1;
    margin: 0 0 0.35rem;
  }
  .stat-label { font-size: 0.85rem; margin: 0; color: #cfcabb; }
  .stat + .stat { border-top: 1px solid #3a372e; padding-top: 1.4rem; }

  .signature { background: var(--ink); color: var(--paper); }
  .signature .slate { color: #b9b5a6; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2.5rem; }
  .split-card { border-radius: 4px; padding: 1.75rem; }
  .split-old { background: #211f19; }
  .split-new { background: linear-gradient(135deg, var(--red), var(--red-deep)); }
  .split-label { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 0.6rem; }
  .split-title { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; margin: 0 0 0.6rem; }

  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; margin-top: 2.5rem; }
  .pillar h3 { margin: 0.6rem 0 0.6rem; }

  .method { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: 1.75rem; max-width: 62ch; }
  .method li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; align-items: baseline; }
  .method h3 { margin: 0 0 0.4rem; font-size: 1.2rem; }

  .cta-band-inner { text-align: center; display: grid; gap: 1.5rem; justify-items: center; max-width: 50ch; margin-inline: auto; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .split { grid-template-columns: 1fr; }
    .pillars { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
