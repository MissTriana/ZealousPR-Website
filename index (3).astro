---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Zealous"
  description="Get in touch with Zealous to talk PR, social and GEO strategy. Email, call, or send a brief and we'll come back with a plan."
  path="/contact/"
>
  <section class="section hero-sm">
    <div class="wrap contact-grid">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Tell us where you want to be known.</h1>
        <p class="lede">Send a few lines about your business and what you're trying to achieve. We'll come back with honest thoughts, not a script.</p>

        <div class="direct">
          <div>
            <p class="eyebrow">Email</p>
            <p><a href="mailto:yasmine.triana@zealouspr.com">yasmine.triana@zealouspr.com</a></p>
          </div>
          <div>
            <p class="eyebrow">Call</p>
            <p><a href="tel:+447496928736">07496 928736</a></p>
          </div>
          <div>
            <p class="eyebrow">Elsewhere</p>
            <p><a href="https://www.linkedin.com/in/yasminetriana" target="_blank" rel="noopener">LinkedIn</a> &middot; <a href="/blog/">The GEO Nerd</a></p>
          </div>
        </div>
      </div>

      <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="contact-form">
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden-field"><label>Don't fill this in: <input name="bot-field" /></label></p>

        <label for="name">Name</label>
        <input id="name" name="name" type="text" required />

        <label for="email">Email</label>
        <input id="email" name="email" type="email" required />

        <label for="company">Company</label>
        <input id="company" name="company" type="text" />

        <label for="message">What are you trying to achieve?</label>
        <textarea id="message" name="message" rows="5" required></textarea>

        <button type="submit" class="btn btn-primary">Send it over</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-sm { padding-block: clamp(2.5rem, 6vw, 4rem) 4rem; }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  h1 { margin-block: 0.6rem 1.2rem; max-width: 16ch; }

  .direct { display: grid; gap: 1.25rem; margin-top: 2.5rem; }
  .direct p:not(.eyebrow) { margin-top: 0.3rem; }
  .direct a { text-decoration: none; border-bottom: 1px solid var(--line); }
  .direct a:hover { color: var(--red); border-color: var(--red); }

  .contact-form { display: grid; gap: 1rem; background: var(--paper-dim); padding: clamp(1.5rem, 3vw, 2.5rem); border-radius: 4px; }
  .contact-form label { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-soft); }
  .contact-form input, .contact-form textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.75em 0.9em;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--paper);
    color: var(--ink);
  }
  .contact-form input:focus, .contact-form textarea:focus {
    outline: 2px solid var(--red);
    outline-offset: 1px;
  }
  .contact-form button { margin-top: 0.5rem; justify-self: start; border: 1px solid var(--ink); }
  .hidden-field { position: absolute; left: -9999px; }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
